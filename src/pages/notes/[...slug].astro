---
import NoteLayout from "@/layouts/NoteLayout.astro";
import { excerptFromBody } from "@/lib/excerpt";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

const titleFromNote = (note: CollectionEntry<"notes">) =>
  note.data.title ??
  note.id
    .split("/")
    .at(-1)!
    .replace(/^\d{4}-\d{2}-\d{2}-/, "")
    .replace(/[-_]/g, " ")
    .replace(/\b\w/g, (char) => char.toUpperCase());

export async function getStaticPaths() {
  const lectureTitleFromNote = (note: CollectionEntry<"notes">) =>
    note.data.title ??
    note.id
      .split("/")
      .at(-1)!
      .replace(/^\d{4}-\d{2}-\d{2}-/, "")
      .replace(/[-_]/g, " ")
      .replace(/\b\w/g, (char) => char.toUpperCase());

  const isIndexPage = (id: string) => {
    const navigationIds = new Set([
      "info",
      "paper",
      "summary",
      "tutorial",
      "tutorial/algorithm",
      "tutorial/deeplearning",
      "tutorial/gcp",
      "tutorial/math",
      "tutorial/mongodb",
      "tutorial/nlp",
      "tutorial/reinforcement_learning"
    ]);
    const parts = id.toLowerCase().split("/");
    const leaf = parts.at(-1);
    return navigationIds.has(id.toLowerCase()) || leaf === "index" || leaf === "summary";
  };

  const notes = (await getCollection("notes", ({ data }) => !data.draft)).filter(
    (note) => !isIndexPage(note.id)
  );

  const compareSeriesNotes = (
    a: CollectionEntry<"notes">,
    b: CollectionEntry<"notes">
  ) => {
    const aIsCurriculum = a.id.endsWith("/curriculum");
    const bIsCurriculum = b.id.endsWith("/curriculum");

    if (aIsCurriculum !== bIsCurriculum) return aIsCurriculum ? -1 : 1;

    return a.id.localeCompare(b.id, undefined, {
      numeric: true,
      sensitivity: "base"
    });
  };

  return notes.map((note) => {
    const articleLink = (article: CollectionEntry<"notes"> | undefined) =>
      article
        ? {
            href: `/notes/${article.id}/`,
            title: lectureTitleFromNote(article)
          }
        : null;
    const seriesParent = note.id.split("/").slice(0, -1).join("/");
    const seriesNotes = notes
      .filter(
        (candidate) =>
          candidate.id.split("/").slice(0, -1).join("/") === seriesParent
      )
      .sort(compareSeriesNotes);
    const seriesIndex = seriesNotes.findIndex((article) => article.id === note.id);
    const seriesArticles = seriesNotes.map((article) => ({
      href: `/notes/${article.id}/`,
      title: lectureTitleFromNote(article),
      isCurrent: article.id === note.id
    }));

    return {
      params: { slug: note.id },
      props: {
        note,
        previousArticle: articleLink(seriesNotes[seriesIndex - 1]),
        nextArticle: articleLink(seriesNotes[seriesIndex + 1]),
        navigationLabel:
          seriesParent === "tutorial/llm_lecture" ? "강의" : "글",
        seriesArticles: seriesArticles.length > 1 ? seriesArticles : []
      }
    };
  });
}

const { note, previousArticle, nextArticle, navigationLabel, seriesArticles } = Astro.props;
const { Content } = await render(note);

const title = titleFromNote(note);
const description = note.data.description ?? excerptFromBody(note.body);
---

<NoteLayout
  title={title}
  description={description}
  previousArticle={previousArticle}
  nextArticle={nextArticle}
  navigationLabel={navigationLabel}
  seriesArticles={seriesArticles}
>
  <Content />
</NoteLayout>
